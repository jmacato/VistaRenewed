<!--
***********************************************************************************************
viogpu3d.props
Enabling and customizing virtio build features
***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">
  <PropertyGroup>
    <Feature_AlwaysDefaultVendor>false</Feature_AlwaysDefaultVendor>
    <Feature_UsingWDF>false</Feature_UsingWDF>
    <Feature_PackOne>true</Feature_PackOne>
    <PackOne_DestinationPrefix>..\</PackOne_DestinationPrefix>
    <Feature_LegacyStampInf>true</Feature_LegacyStampInf>
    <Feature_AdjustInfLegacy>true</Feature_AdjustInfLegacy>
    <Feature_AdjustInf>true</Feature_AdjustInf>
    <SourceInfFile Condition="'$(Configuration)|$(Platform)'=='Vista x86|Win32'">viogpu3d_vista_x86.inx</SourceInfFile>
    <SourceInfFile Condition="'$(Configuration)|$(Platform)'=='Vista x64|x64'">viogpu3d_vista_x64.inx</SourceInfFile>
    <SourceInfFile Condition="'$(Configuration)'!='Vista x86' AND '$(Configuration)'!='Vista x64'">viogpu3d.inx</SourceInfFile>
    <TargetInfFile Condition="'$(Configuration)'=='Vista x86' OR '$(Configuration)'=='Vista x64'">viogpu3d.inf</TargetInfFile>
    <CopyrightStrings>VioGpu3DCopyrightStrings</CopyrightStrings>
  </PropertyGroup>

  <ItemGroup>
    <PackOne_UnsupportedOS Include="@(PackOne_UnsupportedOS);Win8.1" />
  </ItemGroup>
</Project>

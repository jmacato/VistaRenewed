  <PropertyGroup Condition="Exists('$(MESA_PREFIX)\bin\neptune_umd.dll') AND '$(Configuration)'!='Vista x86' AND '$(Configuration)'!='Vista x64'">
    <UseNeptuneArm64x Condition="'$(Platform)'=='ARM64' AND '$(MESA_ARM64X_PREFIX)'!='' AND Exists('$(MESA_ARM64X_PREFIX)\neptune_umd_ec.dll')">true</UseNeptuneArm64x>
    <NeptuneUmdSource Condition="'$(UseNeptuneArm64x)'=='true'">$(MESA_ARM64X_PREFIX)\neptune_umd.dll</NeptuneUmdSource>
    <NeptuneUmdSource Condition="'$(UseNeptuneArm64x)'!='true'">$(MESA_PREFIX)\bin\neptune_umd.dll</NeptuneUmdSource>
    <!-- 32-bit (WOW64) user-mode driver, for x86 D3D apps on an x64 or ARM64
         guest. An ARM64X image is PE32+ and has no 32-bit view, so this is a
         separate x86 build. Pointless on a 32-bit KMD, where it would be the
         native UMD rather than the WOW one. -->
    <UseNeptuneWow Condition="'$(Platform)'!='Win32' AND '$(MESA_X86_PREFIX)'!='' AND Exists('$(MESA_X86_PREFIX)\bin\neptune_umd.dll')">true</UseNeptuneWow>
    <NeptuneWowUmdSource>$(MESA_X86_PREFIX)\bin\neptune_umd.dll</NeptuneWowUmdSource>
    <!-- Staged under a distinct name: it shares the DriverStore directory with
         the 64-bit UMD (dirid 13 has no WoW64 redirection) and dirid 13 forbids
         renaming in CopyFiles, so the rename has to happen at build time. -->
    <NeptuneWowUmd>$(IntDir)neptune_umd_x86.dll</NeptuneWowUmd>

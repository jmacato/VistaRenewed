    <Substitution Include="INX_WOW_COPY">
      <ReplaceWith>neptune_umd_x86.dll,,,0</ReplaceWith>
    </Substitution>
    <!-- %25 is an escaped '%': MSBuild would otherwise read %13 as a hex
         character escape and eat the dirid. -->
    <Substitution Include="INX_WOW_UMDNAME">
      <ReplaceWith>HKR,, UserModeDriverNameWow,       %25REG_MULTI_SZ%25, %2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll</ReplaceWith>
    </Substitution>

  <PropertyGroup Condition="'$(Configuration)'=='Vista x86' OR '$(Configuration)'=='Vista x64'">
    <!-- Inputs from the standalone Vista D3D9 UMD build.  Stage under the
         exact INF names so the native and WoW64 packages cannot accidentally
         pick up the modern neptune_umd.dll. -->
    <VistaD3D9NativeStaged>$(IntDir)neptune_d3d9.dll</VistaD3D9NativeStaged>
    <VistaD3D9WowStaged>$(IntDir)neptune_d3d9_wow.dll</VistaD3D9WowStaged>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)'=='Vista x86' OR '$(Configuration)'=='Vista x64'">
    <FilesToPackage Include="$(VistaD3D9NativeStaged)" />
    <PackOne_Files Include="$(VistaD3D9NativeStaged)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)'=='Vista x64'">
    <FilesToPackage Include="$(VistaD3D9WowStaged)" />
    <PackOne_Files Include="$(VistaD3D9WowStaged)" />
  </ItemGroup>
  <Target Name="StageVistaD3D9Umd" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)'=='Vista x86' OR '$(Configuration)'=='Vista x64'">
    <Error Condition="'$(VISTA_D3D9_UMD)'=='' OR !Exists('$(VISTA_D3D9_UMD)')"
           Text="Vista package requires VISTA_D3D9_UMD (the native neptune_d3d9.dll build)." />
    <Error Condition="'$(Configuration)'=='Vista x64' AND ('$(VISTA_D3D9_WOW_UMD)'=='' OR !Exists('$(VISTA_D3D9_WOW_UMD)'))"
           Text="Vista x64 package requires VISTA_D3D9_WOW_UMD (the x86 neptune_d3d9.dll build)." />
    <Copy SourceFiles="$(VISTA_D3D9_UMD)" DestinationFiles="$(VistaD3D9NativeStaged)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(VISTA_D3D9_WOW_UMD)" DestinationFiles="$(VistaD3D9WowStaged)"
          SkipUnchangedFiles="true" Condition="'$(Configuration)'=='Vista x64'" />
  </Target>
  <Target Name="StageNeptuneWowUmd" BeforeTargets="PrepareForBuild" Condition="'$(UseNeptuneWow)'=='true'" Inputs="$(NeptuneWowUmdSource)" Outputs="$(NeptuneWowUmd)">
    <Message Text="Staging WOW64 user-mode driver $(NeptuneWowUmdSource) as $(NeptuneWowUmd)" Importance="High" />
    <Copy SourceFiles="$(NeptuneWowUmdSource)" DestinationFiles="$(NeptuneWowUmd)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="UpdateVulkanIcdJsons" BeforeTargets="PrepareForBuild" Condition="'$(MESA_PREFIX)' != '' AND Exists('$(ProjectDir)tools\update_icd_jsons.ps1')">
    <Message Text="Updating Vulkan ICD JSONs from $(MESA_PREFIX)" Importance="High" />
    <Exec Command="%25SystemRoot%25\System32\WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\update_icd_jsons.ps1&quot; -MesaPrefix &quot;$(MESA_PREFIX)&quot;" />
  </Target>

# Exported symbols of libdxmt-native.dylib — the native counterpart of the
# per-module .def files, which only apply to PE builds.  Everything else in
# the image (including all of statically-linked LLVM) stays hidden.
#
# ld64 errors on a name that is not defined, so a symbol belongs here only
# if its module is unconditionally part of the image; see
# dxmt_native_d3d12.exports for the optional half.

# src/d3d11/d3d11.def
_D3D11CoreCreateDevice
_D3D11CreateDevice
_D3D11CreateDeviceAndSwapChain
_D3D11On12CreateDevice

# src/dxgi/dxgi.def
_CreateDXGIFactory
_CreateDXGIFactory1
_CreateDXGIFactory2
_DXGIGetDebugInterface1

# src/d3d10/d3d10core.def
_D3D10CoreCreateDevice
_D3D10CoreRegisterLayers

# Embedder API — src/dxmt-native/dxmt_native.h
_dxmt_event_create
_dxmt_event_signal
_dxmt_event_clear
_dxmt_event_close
_dxmt_event_dup_fd
_dxmt_event_wait
_dxmt_d3d11_clear_depth_stencil_rects

--- a/ir/passes/ir_pass_lower_io.cpp
+++ b/ir/passes/ir_pass_lower_io.cpp
@@ -360,6 +360,33 @@ bool LowerIoPass::changeGsInputPrimitiveType(PrimitiveType primitiveType) {
 }
 
 
+bool LowerIoPass::changeGsPassthroughOutputPrimitiveType(PrimitiveType primitiveType) {
+  if (primitiveType == PrimitiveType::eLinesAdj)
+    primitiveType = PrimitiveType::eLines;
+  else if (primitiveType == PrimitiveType::eTrianglesAdj)
+    primitiveType = PrimitiveType::eTriangles;
+
+  if (primitiveType != PrimitiveType::ePoints &&
+      primitiveType != PrimitiveType::eLines &&
+      primitiveType != PrimitiveType::eTriangles)
+    return false;
+
+  auto [a, b] = m_builder.getDeclarations();
+
+  for (auto iter = a; iter != b; iter++) {
+    if (iter->getOpCode() == OpCode::eSetGsOutputPrimitive) {
+      m_builder.rewriteOp(iter->getDef(), Op::SetGsOutputPrimitive(
+        SsaDef(iter->getOperand(0u)), primitiveType, 0x1u));
+    } else if (iter->getOpCode() == OpCode::eSetGsOutputVertices) {
+      m_builder.rewriteOp(iter->getDef(), Op::SetGsOutputVertices(
+        SsaDef(iter->getOperand(0u)), primitiveVertexCount(primitiveType)));
+    }
+  }
+
+  return true;
+}

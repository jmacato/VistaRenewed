+        throw DxvkError("Device lost while resolving predicate");
+      uint32_t value;
+      std::memcpy(&value, m_predicate->buffer->mapPtr(0), sizeof(value));
+      m_predicate->cpuValue = value != 0;
+    }
+    return *m_predicate->cpuValue != m_predicateValue;
+  }

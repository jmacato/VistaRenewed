diff --git a/src/dxvk/shaders/dxvk_draw_auto.comp b/src/dxvk/shaders/dxvk_draw_auto.comp
new file mode 100644
index 0000000..cff6afc
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_draw_auto.comp
@@ -0,0 +1,21 @@
+#version 460
+#extension GL_EXT_buffer_reference : require
+
+layout(local_size_x = 1) in;
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer SourceCounter {
+  uint value;
+};
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer DrawCounter {
+  uint value;
+};
+layout(push_constant) uniform Arguments {
+  SourceCounter source;
+  DrawCounter destination;
+  uint bias;
+} args;
+
+void main() {
+  uint counter = args.source.value;
+  // Compare before subtracting: unsigned underflow would produce a huge draw.
+  args.destination.value = counter > args.bias ? counter - args.bias : 0u;
+}
diff --git a/src/dxvk/shaders/dxvk_predicate_reduce.comp b/src/dxvk/shaders/dxvk_predicate_reduce.comp
new file mode 100644
index 0000000..dcc413f
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_predicate_reduce.comp
@@ -0,0 +1,26 @@
+#version 460
+#extension GL_EXT_buffer_reference : require
+layout(local_size_x = 1) in;
+layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer QueryData {
+  uvec4 entries[];
+};
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer PredicateData {
+  uint value;
+};
+layout(push_constant) uniform Arguments {
+  QueryData source;
+  PredicateData destination;
+  uint count;
+  uint overflow;
+} args;
+void main() {
+  uint result = 0;
+  for (uint i = 0; i < args.count; i++) {
+    uvec4 data = args.source.entries[i];
+    bool passed = args.overflow != 0
+      ? data.w > data.y || (data.w == data.y && data.z > data.x)
+      : (data.x | data.y) != 0;
+    result |= uint(passed);
+  }
+  args.destination.value = result;
+}

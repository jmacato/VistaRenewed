     uint8_t stencil, uint32_t count, const int32_t *rects);
 
+/* Native host ABI. Context, RTV and SRV must belong to this DXVK module and
+ * the same device. Only immediate contexts and private DEFAULT Texture2D
+ * scratch resources with no CPU access, sharing or other misc flags are
+ * supported. Both textures must have one mip, one layer, one sample and
+ * matching dimensions. Aliased resources and external images are rejected.
+ * Both view formats must be UNORM R8G8B8A8, B8G8R8A8 or B8G8R8X8. SRGB views
+ * are unsupported: callers use raw UNORM scratch textures to preserve the
+ * encoded bytes. X8 sources supply alpha 1 through their component mapping.
+ * Copies the whole texture using nearest sampling, without CPU pixel access.
+ * This internal operation is unconditional and preserves application state,
+ * predication and queries. Success acknowledges queued work, not completion;
+ * subsequent operations on the same context execute after the conversion.
+ * Invalid objects/layouts return E_INVALIDARG, unsupported view formats return
+ * DXGI_ERROR_UNSUPPORTED, and device/allocation failures return an error.
+ */
+int32_t dxvk_d3d11_copy_color(void *context, void *dst_rtv, void *src_srv);

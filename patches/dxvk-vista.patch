+  template<typename ContextType>
+  bool D3D11CommonContext<ContextType>::HandlePrivateControl(
+      REFGUID guid, bool write, bool interfaceValue, UINT* size, void* data, HRESULT* result) {
+    const bool caps = guid == GUID TRITON_DITHER_CAPS_GUID;
+    if (!caps && guid != GUID TRITON_DITHER_STATE_GUID)
+      return false;
+
+    D3D10DeviceLock lock = LockContext();
+    *result = E_INVALIDARG;
+    if (interfaceValue || !size)
+      return true;
+
+    const bool supported = m_device->features().extLegacyDithering.legacyDithering;
+    if (write) {
+      if (caps || *size != sizeof(TritonDitherState) || !data)
+        return true;
+      TritonDitherState value;
+      std::memcpy(&value, data, sizeof(value));
+      if (value.version != TRITON_DITHER_VERSION || value.enabled > 1u)
+        return true;
+      if (value.enabled && !supported) {
+        *result = DXGI_ERROR_UNSUPPORTED;
+        return true;
+      }
+      if (m_state.om.legacyDithering != bool(value.enabled)) {
+        m_state.om.legacyDithering = bool(value.enabled);
+        ApplyLegacyDithering();
+      }
+      *result = S_OK;
+      return true;
+    }
+
+    // Both public packets consist of exactly two DWORDs; memcpy also permits
+    // unaligned transport buffers without assuming the caller's C ABI alignment.
+    const uint32_t value[2] = { TRITON_DITHER_VERSION, caps
+      ? (supported ? TRITON_DITHER_NATIVE : 0u)
+      : uint32_t(m_state.om.legacyDithering) };
+    const UINT available = *size;
+    *size = sizeof(value);
+    if (data && available < sizeof(value)) {
+      *result = DXGI_ERROR_MORE_DATA;
+      return true;
+    }
+    if (data)
+      std::memcpy(data, value, sizeof(value));
+    *result = S_OK;
+    return true;
+  }

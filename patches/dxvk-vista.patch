+  HRESULT D3D11ImmediateContext::CopyColor(
+          ID3D11RenderTargetView* DstView,
+          ID3D11ShaderResourceView* SrcView) {
+    D3D10DeviceLock lock = LockContext();
+    auto rtv = dynamic_cast<D3D11RenderTargetView*>(DstView);
+    auto srv = dynamic_cast<D3D11ShaderResourceView*>(SrcView);
+    if (!rtv || !srv)
+      return E_INVALIDARG;
+
+    Com<ID3D11Device> dstDevice, srcDevice;
+    rtv->GetDevice(&dstDevice);
+    srv->GetDevice(&srcDevice);
+    if (dstDevice.ptr() != GetParentInterface()
+     || srcDevice.ptr() != GetParentInterface())
+      return E_INVALIDARG;
+
+    D3D11_RENDER_TARGET_VIEW_DESC dstDesc;
+    D3D11_SHADER_RESOURCE_VIEW_DESC srcDesc;
+    rtv->GetDesc(&dstDesc);
+    srv->GetDesc(&srcDesc);
+    if (dstDesc.ViewDimension != D3D11_RTV_DIMENSION_TEXTURE2D
+     || srcDesc.ViewDimension != D3D11_SRV_DIMENSION_TEXTURE2D
+     || dstDesc.Texture2D.MipSlice
+     || srcDesc.Texture2D.MostDetailedMip
+     || srcDesc.Texture2D.MipLevels != 1)
+      return E_INVALIDARG;
+
+    auto isRawColor = [] (DXGI_FORMAT format) {
+      return format == DXGI_FORMAT_R8G8B8A8_UNORM
+          || format == DXGI_FORMAT_B8G8R8A8_UNORM
+          || format == DXGI_FORMAT_B8G8R8X8_UNORM;
+    };
+    if (!isRawColor(dstDesc.Format) || !isRawColor(srcDesc.Format))
+      return DXGI_ERROR_UNSUPPORTED;
+
+    Com<ID3D11Resource> dstResource, srcResource;
+    rtv->GetResource(&dstResource);
+    srv->GetResource(&srcResource);
+    auto dstTexture = dynamic_cast<D3D11Texture2D*>(dstResource.ptr());
+    auto srcTexture = dynamic_cast<D3D11Texture2D*>(srcResource.ptr());
+    if (!dstTexture || !srcTexture || dstTexture == srcTexture)
+      return E_INVALIDARG;
+
+    auto isScratch = [] (D3D11Texture2D* texture) {
+      D3D11_TEXTURE2D_DESC desc;
+      texture->GetDesc(&desc);
+      auto common = texture->GetCommonTexture();
+      return desc.Usage == D3D11_USAGE_DEFAULT && !desc.CPUAccessFlags
+          && !desc.MiscFlags && desc.MipLevels == 1 && desc.ArraySize == 1
+          && desc.SampleDesc.Count == 1
+          && !common->Get11on12Info().Resource;
+    };
+    if (!isScratch(dstTexture) || !isScratch(srcTexture))
+      return E_INVALIDARG;
+
+    auto dstView = rtv->GetImageView();
+    auto srcView = srv->GetImageView();
+    if (!dstView || !srcView || dstView->image() == srcView->image()
+     || dstView->image()->info().shared || srcView->image()->info().shared
+     || dstView->image()->info().sharing.mode != DxvkSharedHandleMode::None
+     || srcView->image()->info().sharing.mode != DxvkSharedHandleMode::None)
+      return E_INVALIDARG;
+
+    VkExtent3D extent = dstView->mipLevelExtent(0);
+    VkExtent3D srcExtent = srcView->mipLevelExtent(0);
+    if (!extent.width || !extent.height || extent.depth != 1
+     || extent.width > INT32_MAX || extent.height > INT32_MAX
+     || extent.width != srcExtent.width || extent.height != srcExtent.height
+     || srcExtent.depth != 1)
+      return E_INVALIDARG;
+
+    HRESULT hr = m_parent->GetDeviceRemovedReason();
+    if (FAILED(hr))
+      return hr;
+
+    AddCost(GpuCostEstimate::Transfer);
+    EmitCsResource([cDstView = std::move(dstView), cSrcView = std::move(srcView),
+            cExtent = extent] (DxvkContext* ctx) {
+      const VkOffset3D offsets[] = {
+        { 0, 0, 0 }, { int32_t(cExtent.width), int32_t(cExtent.height), 1 }
+      };
+      // The meta path spills rendering and pauses application queries. It
+      // resolves component mappings, including the opaque alpha of X8 views,
+      // without rebinding any D3D11 state or exposing frame pixels to the CPU.
+      ctx->blitImageView(cDstView, offsets, cSrcView, offsets, VK_FILTER_NEAREST);
+    }, false);
+    return S_OK;
+  }

+        // Invalid (unissued or active) predicates must never become an
+        // unconditional command stream. Retain the preceding backend state.
+        if (!predicate) {
+          Logger::err("D3D11: SetPredication requires an ended predicate");
+          return;
+        }
+      }
+      ctx->setPredicate(predicate, value);
+    });

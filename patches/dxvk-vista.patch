+  bool DxvkContext::testPredicate() {
+    if (!m_predicate)
+      return true;
+    if (!m_predicate->cpuValue.has_value()) {
+      // Vulkan cannot predicate transfers or sparse bindings. Resolve once per
+      // immutable query generation, on the CS worker rather than the API thread.
+      flushCommandList(nullptr, nullptr);

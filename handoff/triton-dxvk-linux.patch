From: Jumar Macato <16554748+jmacato@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:23:39 +0800
Subject: [PATCH] Add synchronous Neptune depth and stencil rectangle clears

---
 include/native/dxvk_neptune.h   | 25 ++++++++++++
 include/native/meson.build      |  1 +
 src/d3d11/d3d11.sym             |  1 +
 src/d3d11/d3d11_context.cpp     |  6 ++-
 src/d3d11/d3d11_context_imm.cpp | 67 +++++++++++++++++++++++++++++++++
 src/d3d11/d3d11_context_imm.h   |  6 +++
 src/d3d11/d3d11_main.cpp        | 25 ++++++++++++
 src/dxvk/dxvk_device.cpp        |  6 ++-
 src/dxvk/dxvk_device.h          |  2 +-
 9 files changed, 135 insertions(+), 4 deletions(-)
 create mode 100644 include/native/dxvk_neptune.h

diff --git a/include/native/dxvk_neptune.h b/include/native/dxvk_neptune.h
new file mode 100644
index 0000000..bfd58cb
--- /dev/null
+++ b/include/native/dxvk_neptune.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: Zlib */
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Native host ABI, not the COM calling convention. Context and DSV must
+ * belong to this DXVK module and the same device. Only immediate contexts
+ * are supported. Flags are D3D11_CLEAR_DEPTH (1) / D3D11_CLEAR_STENCIL (2).
+ * Each rectangle is four signed integers: left, top, right, bottom.
+ * Count must be 1..4096 and every rectangle must be nonempty and in bounds.
+ * The entire batch is validated before recording. Success means submitted
+ * GPU work completed; unselected planes and pixels outside rectangles are
+ * preserved. A device failure can leave a partially executed batch.
+ */
+int32_t dxvk_d3d11_clear_depth_stencil_rects(
+    void *context, void *view, uint32_t flags, float depth,
+    uint8_t stencil, uint32_t count, const int32_t *rects);
+
+#ifdef __cplusplus
+}
+#endif

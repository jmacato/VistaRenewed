+    ULONG *destination = (ULONG *)allocationBytes;
+    const SIZE_T valueCount = fillSize / sizeof(ULONG);
+    for (SIZE_T i = 0; i < valueCount; ++i)
+    {
+        destination[i] = pBuildPagingBuffer->Fill.FillPattern;
+    }
     return STATUS_SUCCESS;

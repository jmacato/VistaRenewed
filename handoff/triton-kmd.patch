+            (ULONG)allocationOffset);
+        if (destination == NULL)
+        {
+            return STATUS_INSUFFICIENT_RESOURCES;
+        }
+
+        const SIZE_T valueCount = fillSize / sizeof(ULONG);
+        for (SIZE_T i = 0; i < valueCount; ++i)

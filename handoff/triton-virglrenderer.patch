+                            struct npt_cs_decoder *dec,
+                            struct npt_cs_encoder *enc,
+                            const struct npt_command_header *header,
+                            uint32_t method)
+{
+   switch (method) {
+   case NPT_TRANSPORT_CLEAR_DEPTH_STENCIL_RECTS:
+      npt_dispatch_clear_depth_stencil_rects(ctx, dispatch, dec, enc, header);
+      return true;
+   default:
+      return false;
+   }
+}

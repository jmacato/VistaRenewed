diff --git a/build/toolchain/win/toolchain.gni b/build/toolchain/win/toolchain.gni
--- a/build/toolchain/win/toolchain.gni
+++ b/build/toolchain/win/toolchain.gni
@@ -14,6 +14,11 @@
 assert(is_win, "Should only be running on Windows")
 
+declare_args() {
+  triton_rc_sdk_overlay = ""
+  triton_rc_vctools_version = ""
+}
+
 # This tool will is used as a wrapper for various commands below.
@@ -267,1 +272,8 @@
       command = "\"$python_path\" $_tool_wrapper_path rc-wrapper $env rc.exe /nologo $werror$sys_include_flags{{defines}} {{include_dirs}} /fo{{output}} {{source}}"
+      if (triton_rc_sdk_overlay != "") {
+        command += " --sdk-overlay=\"" +
+                   rebase_path(triton_rc_sdk_overlay, root_build_dir) + "\""
+      }
+      if (triton_rc_vctools_version != "") {
+        command += " --vctools-version=$triton_rc_vctools_version"
+      }
       depsformat = "msvc"
       outputs = [ "$object_subdir/{{source_name_part}}.res" ]
       description = "RC {{output}}"

+    elif flag.startswith('--vctools-version='):
+      preprocess_flags += ['/vctoolsversion', flag.split('=', 1)[1]]
     elif (flag.startswith('-') or
@@ -90,2 +98,2 @@
-      'show_includes', 'werror'
+      'show_includes', 'werror', 'preprocess_flags'
   ])
@@ -98,2 +107,3 @@
                show_includes=show_includes,
-               werror=werror)
